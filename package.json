{
  "name": "curfew",
  "version": "0.1.0",
  "description": "Run batches from an (async) iterable and stop before a time budget runs out.",
  "keywords": [
    "batch",
    "deadline",
    "timeout",
    "time-budget",
    "lambda",
    "aws-lambda",
    "abortsignal",
    "graceful-shutdown"
  ],
  "license": "MIT",
  "author": "",
  "homepage": "",
  "repository": "",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc",
    "lint:pkg": "publint && attw --pack .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.5",
    "publint": "^0.3.25",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
