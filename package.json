{
  "name": "curfew",
  "version": "0.2.0",
  "description": "Run batches from an (async) iterable and stop before a time budget runs out.",
  "keywords": [
    "batch",
    "deadline",
    "timeout",
    "time-budget",
    "lambda",
    "aws-lambda",
    "abortsignal",
    "graceful-shutdown"
  ],
  "license": "MIT",
  "author": "Pushkal Guha Choudhury",
  "homepage": "https://github.com/Maganlal-Meghraj/curfew#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maganlal-Meghraj/curfew.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:pkg": "publint && attw --pack .",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "changeset publish",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build && npm run lint:pkg"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "publint": "^0.3.25",
    "tsdown": "0.23.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
